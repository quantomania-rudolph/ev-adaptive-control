# Data and results: big or regenerable files do NOT belong in git.
# Generate them with the datagen segment, or share them via the team drive.
data/raw/*
data/processed/*
results/*
!data/raw/.gitkeep
!data/processed/.gitkeep
!results/.gitkeep
*.npz
*.h5
*.mat
